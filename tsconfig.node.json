{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,

    "outDir": "./.tsbuild/node",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],

    "tsBuildInfoFile": "./.tsbuild/node.tsbuildinfo",

    "skipLibCheck": true
  },
  "include": ["tools/**/*.mts"]
}
