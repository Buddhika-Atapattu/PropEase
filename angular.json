{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "propease-fontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/propease-fontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js", "@angular/localize/init"],
            "inlineStyleLanguage": "scss",
            "assets": [
              { "glob": "**/*", "input": "public", "output": "" },
              {
                "glob": "**/*",
                "input": "node_modules/tinymce/skins",
                "output": "tinymce/skins"
              },
              {
                "glob": "**/*",
                "input": "node_modules/tinymce/icons",
                "output": "tinymce/icons"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                "output": "assets/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@fortawesome/fontawesome-free/webfonts",
                "output": "webfonts"
              },
              {
                "glob": "**/*",
                "input": "node_modules/material-design-icons/iconfont",
                "output": "assets/iconfont"
              }
            ],
            "styles": [
              "@fortawesome/fontawesome-free/css/all.min.css",
              "leaflet/dist/leaflet.css",
              "leaflet-geosearch/dist/geosearch.css",
              "node_modules/material-design-icons/iconfont/material-icons.css",
              "node_modules/material-symbols/index.css",
              "src/styles.scss",
              "src/app/styles/global.scss",
              "src/app/styles/material-overrides.scss"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
          },
          "configurations": {
            "web": {
              "index": "src/index.html",
              "baseHref": "/",
              "serviceWorker": "ngsw-config.json",
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": false
            },
            "electron": {
              "index": "src/index.html",
              "baseHref": "./",
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.electron.ts"
                }
              ]
            },
            "development": {
              "index": "src/index.html",
              "baseHref": "/",
              "serviceWorker": "ngsw-config.json",
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "none"
            },
            "production": {
              "index": "src/index.html",
              "baseHref": "/",
              "serviceWorker": "ngsw-config.json",
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "web"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "propease-fontend:build:development",
            "host": "0.0.0.0",
            "port": 4200
          },
          "configurations": {
            "development": {
              "buildTarget": "propease-fontend:build:development"
            },
            "web": {
              "buildTarget": "propease-fontend:build:web"
            },
            "electron": {
              "buildTarget": "propease-fontend:build:electron"
            },
            "production": {
              "buildTarget": "propease-fontend:build:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [{ "glob": "**/*", "input": "public", "output": "" }],
            "styles": [
              "@fortawesome/fontawesome-free/css/all.min.css",
              "leaflet/dist/leaflet.css",
              "leaflet-geosearch/dist/geosearch.css",
              "node_modules/material-design-icons/iconfont/material-icons.css",
              "node_modules/material-symbols/index.css",
              "src/styles.scss",
              "src/app/styles/global.scss",
              "src/app/styles/material-overrides.scss"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
